.build/
.swiftpm/
dist/
*.build-*/
.DS_Store
# local-only test scaffolding (hardcoded absolute paths, not meant to ship)
test-assets/

# NEVER commit the real token - this repo is public. The file with the
# real token stays local-only; PrivateCatalogAuth.swift.example is the
# tracked template. See README for how to set this up on a new machine.
Sources/GDCPluginManagerCore/PrivateCatalogAuth.swift

# Same reasoning as above: the Supabase service_role key bypasses Row
# Level Security entirely (full read access to devices/download_events,
# including customer emails) - it must never leave this Mac. Only
# Furnizor holds it; the client app only ever gets the RLS-limited
# insert-only anon key (see GDCPluginManagerCore/SupabaseConfig.swift,
# which IS safe to commit).
Sources/GDCPluginManagerFurnizor/SupabaseAdminConfig.swift

# Python portabil bundle-uit — ~66MB, resursa binara redistribuibila, nu
# cod sursa. Ruleaza ./fetch_python_runtime.sh o data pe masina noua.
PythonRuntime/

# SECURITATE (2026-08-25): certificate Apple / chei private / provisioning
# profiles NU trebuie NICIODATA sa ajunga intr-un commit, in niciun repo,
# public sau privat - sistemele automate Apple pot detecta si REVOCA
# certificate expuse, iar contul de Developer poate fi suspendat. Acestea
# stau exclusiv local, in ~/Developer/Certificates/ (in afara oricarui
# repo git) - vezi PROJECT_STRUCTURE.md / CLAUDE.md pentru detalii.
*.p12
*.cer
*.p8
*.key
*.pem
*.mobileprovision
__pycache__/
