{
  "_comentariu": "Manifest PWA pentru gordas.dev. start_url = /app.html (interfata de aplicatie), NU index.html (pagina de prezentare, ramane pentru vizitatorii din browser). Scope-ul e radacina domeniului, ca paginile de produs (/datamover/ etc.) sa se deschida tot in aplicatie. Aplicatia mobila NU mai e un APK/TWA (retras 2026-08-24) - acest PWA e chiar aplicatia, deschisa direct in browser pe Android si iPhone.",
  "id": "/",
  "name": "GDC Manager",
  "short_name": "GDC",
  "description": "Catalogul GDC pe telefon: plugin-uri, LUT-uri si DCTL-uri pentru DaVinci Resolve, resurse download, cursuri, evenimente, magazine partenere, servicii, oferte si pachete.",
  "lang": "ro",
  "dir": "ltr",
  "start_url": "/app.html?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait-primary",
  "background_color": "#070f0e",
  "theme_color": "#070f0e",
  "categories": [
    "productivity",
    "education",
    "photo",
    "video"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Produsele mele",
      "short_name": "Produse",
      "url": "/app.html?source=pwa#produse",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Resurse download",
      "short_name": "Resurse",
      "url": "/app.html?source=pwa#resurse",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Cursuri",
      "short_name": "Cursuri",
      "url": "/app.html?source=pwa#cursuri",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Evenimente",
      "short_name": "Evenimente",
      "url": "/app.html?source=pwa#evenimente",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "prefer_related_applications": false
}
